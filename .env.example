# Copied by docker compose / dotenv. All optional; defaults shown.

# Session signing secret. Change it outside local dev.
JWT_SECRET=dev-only-change-me

# Comma-separated usernames that are admins. Everyone else is a player.
ADMIN_USERNAMES=thales,ricardo

# Create the club's 20 players on startup (logins in `make credentials`). Idempotent.
SEED_PLAYERS=true

# Host ports used by docker compose
APP_PORT=3000
DB_PORT=5432

# Used only when running the API outside Docker (npm run dev:server)
DATABASE_URL=postgres://tennis:tennis@localhost:5432/tennis
